@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="mx-auto max-w-xl">
    <div class="mb-6">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Change password</h2>
        <p class="mt-1 text-sm text-slate-600">Use at least 6 characters. You stay signed in after the change.</p>
    </div>

    <div class="card">
        <div class="card-body sm:p-8">
            <form asp-action="ChangePassword" method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly"></div>
                <div>
                    <label asp-for="CurrentPassword" class="label"></label>
                    <input asp-for="CurrentPassword" class="input" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword"></span>
                </div>
                <div>
                    <label asp-for="NewPassword" class="label"></label>
                    <input asp-for="NewPassword" class="input" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="label"></label>
                    <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <div class="flex items-center justify-end gap-3 pt-2">
                    <a class="btn btn-secondary" asp-action="Profile">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
