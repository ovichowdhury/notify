@model ProfileViewModel
@{
    ViewData["Title"] = "Company profile";
}

<div class="mx-auto max-w-3xl">
    <div class="mb-6">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Company profile</h2>
        <p class="mt-1 text-sm text-slate-600">Your company name and logo are shown across the workspace.</p>
    </div>

    <form asp-action="Profile" method="post" enctype="multipart/form-data" class="space-y-6">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Identity</h3></div>
            <div class="card-body grid gap-5 sm:grid-cols-2">
                <div>
                    <label class="label">Login email</label>
                    <input class="input" value="@Model.Email" disabled />
                    <p class="hint">The email you sign in with cannot be changed.</p>
                </div>
                <div>
                    <label asp-for="CompanyName" class="label"></label>
                    <input asp-for="CompanyName" class="input" />
                    <span asp-validation-for="CompanyName"></span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Logo</h3></div>
            <div class="card-body">
                <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
                    <div class="flex h-24 w-40 shrink-0 items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50 p-2">
                        @if (!string.IsNullOrEmpty(Model.LogoPath))
                        {
                            <img src="@Model.LogoPath" alt="Company logo" class="max-h-full max-w-full object-contain" />
                        }
                        else
                        {
                            <span class="text-xs text-slate-400">No logo yet</span>
                        }
                    </div>
                    <div class="flex-1 space-y-3">
                        <div>
                            <label asp-for="Logo" class="label">Upload a new logo</label>
                            <input asp-for="Logo" type="file" class="input-file" accept=".png,.jpg,.jpeg,.gif,.webp" />
                            <p class="hint">PNG, JPG, GIF or WEBP, up to 2 MB. Shown in the sidebar.</p>
                            <span asp-validation-for="Logo"></span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.LogoPath))
                        {
                            <label class="flex items-center gap-2 text-sm text-slate-700">
                                <input asp-for="RemoveLogo" class="h-4 w-4 rounded border-slate-300 text-red-600 focus:ring-red-600" />
                                <span>Remove current logo</span>
                            </label>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3">
            <a class="btn btn-secondary" asp-action="ChangePassword">Change password</a>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
