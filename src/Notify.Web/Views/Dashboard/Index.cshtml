@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var deliveryRate = Model.TotalSent + Model.TotalFailed == 0 ? 0 : Math.Round(100.0 * Model.TotalSent / (Model.TotalSent + Model.TotalFailed), 1);
}

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Welcome back, @Model.CompanyName</h2>
        <p class="mt-1 text-sm text-slate-600">Here is how your email campaigns are doing.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Campaigns" asp-action="Create">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        New campaign
    </a>
</div>

@if (!Model.SmtpConfigured)
{
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4">
        <div class="flex items-start gap-3 text-sm text-amber-800">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
            <div><span class="font-semibold">SMTP is not configured.</span> Campaigns cannot be sent until you connect a mail server.</div>
        </div>
        <a class="btn btn-warning btn-sm" asp-controller="Settings" asp-action="Smtp">Configure SMTP</a>
    </div>
}

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="card card-body">
        <div class="flex items-center justify-between">
            <p class="section-title">Campaigns</p>
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46" /></svg>
            </span>
        </div>
        <p class="stat-value">@Model.CampaignCount</p>
        <p class="mt-1 text-xs text-slate-500">@Model.ActiveCampaigns running now</p>
    </div>
    <div class="card card-body">
        <div class="flex items-center justify-between">
            <p class="section-title">Recipients</p>
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            </span>
        </div>
        <p class="stat-value">@Model.TotalRecipients</p>
        <p class="mt-1 text-xs text-slate-500">@Model.TotalPending pending</p>
    </div>
    <div class="card card-body">
        <div class="flex items-center justify-between">
            <p class="section-title">Delivered</p>
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </span>
        </div>
        <p class="stat-value text-emerald-600">@Model.TotalSent</p>
        <p class="mt-1 text-xs text-slate-500">@deliveryRate% delivery rate</p>
    </div>
    <div class="card card-body">
        <div class="flex items-center justify-between">
            <p class="section-title">Failed</p>
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-red-50 text-red-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </span>
        </div>
        <p class="stat-value text-red-600">@Model.TotalFailed</p>
        <p class="mt-1 text-xs text-slate-500">across all campaigns</p>
    </div>
</div>

<div class="card mt-6">
    <div class="card-header">
        <h3 class="card-title">Recent campaigns</h3>
        <a class="text-sm font-medium text-brand-600 hover:text-brand-500" asp-controller="Campaigns" asp-action="Index">View all</a>
    </div>
    @if (Model.RecentCampaigns.Count == 0)
    {
        <div class="card-body py-12 text-center">
            <p class="text-sm text-slate-500">No campaigns yet.</p>
            <a class="btn btn-primary mt-4" asp-controller="Campaigns" asp-action="Create">Create your first campaign</a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="th">Campaign</th>
                        <th class="th">Status</th>
                        <th class="th text-right">Recipients</th>
                        <th class="th text-right">Delivered</th>
                        <th class="th text-right">Failed</th>
                        <th class="th">Created</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var c in Model.RecentCampaigns)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="td">
                                <a class="font-medium text-slate-900 hover:text-brand-600" asp-controller="Campaigns" asp-action="Details" asp-route-id="@c.Id">@c.Name</a>
                                <p class="truncate text-xs text-slate-500">@c.Subject</p>
                            </td>
                            <td class="td"><partial name="_StatusBadge" model="c.Status" /></td>
                            <td class="td text-right tabular-nums">@c.Total</td>
                            <td class="td text-right tabular-nums text-emerald-600">@c.Sent</td>
                            <td class="td text-right tabular-nums text-red-600">@c.Failed</td>
                            <td class="td text-slate-500">@c.CreatedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
