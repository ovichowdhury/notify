@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="mx-auto max-w-md py-16 text-center">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-50 text-amber-600">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
    </span>
    <h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-900">Something went wrong</h2>
    <p class="mt-2 text-sm text-slate-600">An error occurred while processing your request. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-xs text-slate-400">Request ID <code class="rounded bg-slate-100 px-1">@Model.RequestId</code></p>
    }
    <a class="btn btn-primary mt-6" asp-controller="Home" asp-action="Index">Go home</a>
</div>
