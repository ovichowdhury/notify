@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    ApplicationUser? currentUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
    var brand = string.IsNullOrWhiteSpace(currentUser?.CompanyName) ? "Notify" : currentUser!.CompanyName;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var initials = string.IsNullOrWhiteSpace(brand) ? "N" : brand.Trim()[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Notify</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="~/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="h-full font-sans text-slate-900 antialiased">
@if (isAuthenticated)
{
    <div class="min-h-full">
        <!-- Mobile sidebar backdrop -->
        <div id="sidebar-backdrop" class="fixed inset-0 z-40 hidden bg-slate-900/60 lg:hidden"></div>

        <!-- Sidebar -->
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col bg-slate-900 transition-transform duration-200 lg:translate-x-0">
            <div class="flex h-16 items-center gap-3 px-6">
                @if (!string.IsNullOrEmpty(currentUser?.LogoPath))
                {
                    <img src="@currentUser.LogoPath" alt="Logo" class="h-9 max-w-[140px] rounded-md bg-white object-contain p-1" />
                }
                else
                {
                    <img src="~/images/logo-mark.svg" alt="" class="h-9 w-9 shrink-0" />
                }
                <span class="truncate text-base font-semibold text-white">@brand</span>
            </div>
            <nav class="flex-1 space-y-1 px-4 py-4">
                <a class="nav-link @(controller == "Dashboard" ? "nav-link-active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75" /></svg>
                    Dashboard
                </a>
                <a class="nav-link @(controller == "Campaigns" ? "nav-link-active" : "")" asp-controller="Campaigns" asp-action="Index">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46" /></svg>
                    Campaigns
                </a>
                <a class="nav-link @(controller == "Settings" ? "nav-link-active" : "")" asp-controller="Settings" asp-action="Smtp">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
                    SMTP settings
                </a>
                <div class="pt-4">
                    <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Account</p>
                    <a class="nav-link @(controller == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "nav-link-active" : "")" asp-controller="Account" asp-action="Profile">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" /></svg>
                        Company profile
                    </a>
                    <a class="nav-link @(controller == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "ChangePassword" ? "nav-link-active" : "")" asp-controller="Account" asp-action="ChangePassword">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" /></svg>
                        Change password
                    </a>
                </div>
            </nav>
            <div class="border-t border-slate-800 p-4">
                <div class="flex items-center gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-700 text-sm font-semibold text-white">@initials</span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium text-white">@brand</p>
                        <p class="truncate text-xs text-slate-400">@currentUser?.Email</p>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="rounded-lg p-2 text-slate-400 hover:bg-slate-800 hover:text-white" title="Sign out">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main column -->
        <div class="lg:pl-72">
            <header class="sticky top-0 z-30 flex h-16 items-center gap-4 border-b border-slate-200 bg-white/80 px-4 backdrop-blur sm:px-6 lg:px-8">
                <button id="sidebar-toggle" type="button" class="-ml-2 rounded-lg p-2 text-slate-600 hover:bg-slate-100 lg:hidden" aria-label="Open navigation">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                </button>
                <h1 class="truncate text-base font-semibold text-slate-900">@ViewData["Title"]</h1>
                <div class="ml-auto flex items-center gap-3">
                    <a class="btn btn-primary btn-sm hidden sm:inline-flex" asp-controller="Campaigns" asp-action="Create">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        New campaign
                    </a>
                    <div class="relative">
                        <button id="user-menu-toggle" type="button" class="flex items-center gap-2 rounded-full p-1 pr-2 text-sm text-slate-700 hover:bg-slate-100">
                            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-semibold text-white">@initials</span>
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                        </button>
                        <div id="user-menu" class="absolute right-0 mt-2 hidden w-56 origin-top-right rounded-xl bg-white py-1 shadow-lg ring-1 ring-slate-200">
                            <div class="border-b border-slate-100 px-4 py-3">
                                <p class="truncate text-sm font-medium text-slate-900">@brand</p>
                                <p class="truncate text-xs text-slate-500">@currentUser?.Email</p>
                            </div>
                            <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50" asp-controller="Account" asp-action="Profile">Company profile</a>
                            <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50" asp-controller="Account" asp-action="ChangePassword">Change password</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="border-t border-slate-100">
                                <button type="submit" class="block w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50">Sign out</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <div class="flex min-h-full flex-col">
        <header class="border-b border-slate-200/80 bg-white/70 backdrop-blur">
            <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
                <a class="flex items-center gap-2.5" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-mark.svg" alt="" class="h-9 w-9" />
                    <span class="text-lg font-semibold tracking-tight text-slate-900">Notify</span>
                </a>
                <nav class="flex items-center gap-2">
                    <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create account</a>
                </nav>
            </div>
        </header>
        <main class="flex-1">
            <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
                <partial name="_Alerts" />
            </div>
            @RenderBody()
        </main>
        <footer class="border-t border-slate-200 py-6 text-center text-xs text-slate-500">
            Notify · Email campaign management
        </footer>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
