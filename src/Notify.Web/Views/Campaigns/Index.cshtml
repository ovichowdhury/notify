@model List<CampaignListItemViewModel>
@{
    ViewData["Title"] = "Campaigns";
}

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Campaigns</h2>
        <p class="mt-1 text-sm text-slate-600">@Model.Count campaign(s) in your workspace.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        New campaign
    </a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body py-16 text-center">
            <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 text-brand-600">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
            </span>
            <h3 class="mt-4 text-base font-semibold text-slate-900">No campaigns yet</h3>
            <p class="mt-1 text-sm text-slate-500">Create a campaign, upload your client list and send.</p>
            <a class="btn btn-primary mt-6" asp-action="Create">Create your first campaign</a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="th">Campaign</th>
                        <th class="th">Status</th>
                        <th class="th w-48">Progress</th>
                        <th class="th text-right">Recipients</th>
                        <th class="th text-right">Delivered</th>
                        <th class="th text-right">Failed</th>
                        <th class="th">Created</th>
                        <th class="th"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var c in Model)
                    {
                        var processed = c.Sent + c.Failed;
                        var pct = c.Total == 0 ? 0 : (int)Math.Round(100.0 * processed / c.Total);
                        var sentPct = c.Total == 0 ? 0 : 100.0 * c.Sent / c.Total;
                        var failedPct = c.Total == 0 ? 0 : 100.0 * c.Failed / c.Total;
                        <tr class="hover:bg-slate-50">
                            <td class="td">
                                <a class="font-medium text-slate-900 hover:text-brand-600" asp-action="Details" asp-route-id="@c.Id">@c.Name</a>
                                <p class="max-w-xs truncate text-xs text-slate-500">@c.Subject</p>
                            </td>
                            <td class="td"><partial name="_StatusBadge" model="c.Status" /></td>
                            <td class="td">
                                <div class="flex items-center gap-2">
                                    <div class="flex h-2 flex-1 overflow-hidden rounded-full bg-slate-100">
                                        <div class="bg-emerald-500" style="width:@sentPct.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        <div class="bg-red-400" style="width:@failedPct.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    </div>
                                    <span class="w-9 text-right text-xs tabular-nums text-slate-500">@pct%</span>
                                </div>
                            </td>
                            <td class="td text-right tabular-nums">@c.Total</td>
                            <td class="td text-right tabular-nums text-emerald-600">@c.Sent</td>
                            <td class="td text-right tabular-nums text-red-600">@c.Failed</td>
                            <td class="td whitespace-nowrap text-slate-500">@c.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td class="td text-right">
                                <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@c.Id">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
