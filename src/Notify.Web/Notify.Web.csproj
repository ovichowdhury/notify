<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Standalone Tailwind CLI (git-ignored). Download once with: powershell -File scripts/get-tailwind.ps1 -->
    <TailwindCli>$(MSBuildProjectDirectory)\..\..\scripts\tailwindcss.exe</TailwindCli>
  </PropertyGroup>

  <!-- Compiles Styles/app.css into wwwroot/css/tailwind.css before each build when the CLI is available.
       The generated file is committed, so builds still succeed on machines without the CLI. -->
  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" Condition="Exists('$(TailwindCli)')">
    <Message Importance="high" Text="Compiling Tailwind CSS -> wwwroot/css/tailwind.css" />
    <Exec Command="&quot;$(TailwindCli)&quot; -c tailwind.config.js -i Styles/app.css -o wwwroot/css/tailwind.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <Content Remove="Styles\**" />
    <None Include="Styles\**" />
    <None Include="tailwind.config.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.8" />
  </ItemGroup>

</Project>
