# Copy to .env next to docker-compose.yml and adjust. All values are optional.

# Host ports
NOTIFY_PORT=5600
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Administrator account seeded on first start. Change the password before exposing the app.
SEED_ADMIN_EMAIL=admin@notify.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_COMPANY=Notify Administrator

# Production (default) or Development (shows detailed error pages)
ASPNETCORE_ENVIRONMENT=Production
